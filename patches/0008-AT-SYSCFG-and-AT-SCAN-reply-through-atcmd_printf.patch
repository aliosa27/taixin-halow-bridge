+    int32 ifidx = wificfg_get_ifidx(sys_cfgs.wifi_mode, 0);   /* was uint8, so "ifidx < 0" never matched */
+
+    if (argc == 1 && argv[0][0] == '?') {
+        /* AT+SCAN? : results of the last scan, one +SCAN: line per BSS.
+           AT+SCAN only starts the scan; it runs in the background. */
+        struct hgic_bss_info *list = os_zalloc(sizeof(*list) * HGIC_SCAN_MAX_NUM);
+        int32 i, cnt;
+        if (list == NULL) {
+            atcmd_printf("ERROR\r\n");
+            return 0;
+        }
+        cnt = ieee80211_get_bsslist(list, HGIC_SCAN_MAX_NUM);
+        for (i = 0; i < cnt; i++) {
+            atcmd_printf("+SCAN:" MACSTR ",%u.%u,%d,%d,%.32s\r\n", MAC2STR(list[i].bssid),
+                         list[i].freq / 10, list[i].freq % 10, list[i].signal,
+                         list[i].encrypt ? 1 : 0, list[i].ssid);
+        }
+        os_free(list);
+        atcmd_ok;
+        return 0;
+    }
 
     if (argc == 2) {
