+/* dump_key() prints with _os_printf (UART log); this one goes through atcmd_printf */
+static void syscfg_dump_key(const char *str, const uint8 *key)
+{
+    char hex[65];
+    int32 i;
+    for (i = 0; i < 32; i++) {
+        os_sprintf(hex + 2 * i, "%02x", key[i]);
+    }
+    atcmd_printf("%s%s\r\n", str, hex);
+}
