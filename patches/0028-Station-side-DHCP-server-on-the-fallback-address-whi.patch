diff --git a/project/main.c b/project/main.c
index ce3a1cf..b1f5480 100644
--- a/project/main.c
+++ b/project/main.c
@@ -339,6 +339,43 @@ const char *sys_dhcp_hostname(void)
 }
 
 #define SYS_DHCPC_FALLBACK_SEC 60   /* no DHCP lease for this long: fall back to 192.168.123.1/24 */
+#define SYS_FALLBACK_IP        0x017BA8C0   /* 192.168.123.1 */
+
+/* Station side, on the fallback address with no WiFi link: also serve DHCP
+ * (192.168.123.100-200, 2-minute leases), so a PC cabled straight to the
+ * device gets an address. 60 s without a lease means no DHCP server answered
+ * on the Ethernet side. Stopped as soon as the link comes up (events.c) or a
+ * lease arrives, so it never competes with a real server across the bridge;
+ * the short lease makes clients move to the real network soon after. */
+static uint8 sys_fallback_dhcpd_on;
+
+void sys_fallback_dhcpd(uint8 on)
+{
+    struct dhcpd_param param;
+
+    if (on == sys_fallback_dhcpd_on) {
+        return;
+    }
+    sys_fallback_dhcpd_on = on;
+    if (!on) {
+        dhcpd_stop("w0");
+        os_printf(KERN_NOTICE"fallback dhcp server stopped\r\n");
+        return;
+    }
+    os_memset(&param, 0, sizeof(param));
+    param.start_ip   = 0x647BA8C0;          /* 192.168.123.100 */
+    param.end_ip     = 0xC87BA8C0;          /* 192.168.123.200 */
+    param.netmask    = 0x00FFFFFF;
+    param.router     = SYS_FALLBACK_IP;
+    param.dns1       = SYS_FALLBACK_IP;
+    param.dns2       = SYS_FALLBACK_IP;
+    param.lease_time = 120;
+    if (dhcpd_start("w0", &param)) {
+        os_printf("dhcpd start error\r\n");  /* not retried until the next fallback */
+    } else {
+        os_printf(KERN_NOTICE"no wifi link: dhcp server on 192.168.123.100-200\r\n");
+    }
+}
 
 static void sys_dhcpc_check(void)
 {
@@ -359,13 +396,17 @@ static void sys_dhcpc_check(void)
         nolease_sec = 0;
     } else if (nolease_sec < SYS_DHCPC_FALLBACK_SEC && ++nolease_sec == SYS_DHCPC_FALLBACK_SEC) {
         ip_addr_t ip, mask, gw;
-        ip.addr   = 0x017BA8C0;             /* 192.168.123.1 */
+        ip.addr   = SYS_FALLBACK_IP;
         mask.addr = 0x00FFFFFF;             /* 255.255.255.0 */
         gw.addr   = 0;
         lwip_netif_set_ip2("w0", &ip, &mask, &gw);
         lwip_netif_set_dhcp2("w0", 1);
         os_printf(KERN_NOTICE"no dhcp lease after %ds, fallback ip 192.168.123.1\r\n", SYS_DHCPC_FALLBACK_SEC);
     }
+
+    /* Also follows link loss after the fallback, as long as the address is still the fallback one. */
+    sys_fallback_dhcpd(nolease_sec == SYS_DHCPC_FALLBACK_SEC && !MODE_IS_AP(sys_cfgs.wifi_mode) &&
+                       !sys_status.wifi_connected && nif->ip_addr.addr == SYS_FALLBACK_IP);
 }
 
 static void sys_print_dbgtime(uint32 *buff, uint32 size)
